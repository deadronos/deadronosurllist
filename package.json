{
  "name": "deadronosurllist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dotenvx": "dotenvx",
    "build": "dotenvx run -- next build",
    "check": "npm run lint && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "npm run db:migrate:deploy",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:migrate:status": "prisma migrate status",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "dotenvx run -- next dev --turbo",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,js,jsx,mdx}\"",
    "analyze": "ANALYZE=true dotenvx run -- next build",
    "format:write": "oxfmt --write \"**/*.{ts,tsx,js,jsx,mdx}\"",
    "postinstall": "prisma generate",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "load:catalog": "k6 run scripts/load/catalog.js",
    "load:health": "k6 run scripts/load/health.js",
    "preview": "dotenvx run -- next build && dotenvx run -- next start",
    "start": "dotenvx run -- next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:contract": "vitest run src/test/contract",
    "test:contract:watch": "vitest watch src/test/contract",
    "visual:test": "npx playwright test tests/visual.spec.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
